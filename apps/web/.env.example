# Salin ke .env lalu isi. JANGAN commit .env.

# Database PostgreSQL (Supabase → Project Settings → Database → Connection string).
# DATABASE_URL: "Transaction pooler" (port 6543) + ?pgbouncer=true&connection_limit=1  (dipakai app/serverless)
# DIRECT_URL:   "Direct connection" atau "Session pooler" (port 5432)                    (dipakai migrasi)
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Rahasia sesi (JWT). Isi string acak panjang, mis. hasil: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# RPC Sepolia untuk server (relayer + baca kontrak)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Wallet relayer: membayar gas untuk semua pengguna. Butuh Sepolia ETH.
# Untuk faucet IDRX dan freeze otomatis, wallet ini harus owner MockIDRX dan punya ADMIN/FREEZER_ROLE
# (deployer di piutangchain-contracts/.env memenuhi keduanya).
RELAYER_PRIVATE_KEY=

# Demo hackathon: tampilkan kode OTP di layar karena provider SMS belum disambung. Kosongkan untuk rilis sungguhan.
OTP_DEMO=1

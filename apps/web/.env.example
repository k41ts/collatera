# Salin ke .env lalu isi. JANGAN commit .env.

# Database: SQLite lokal (default). Untuk Postgres/Supabase lihat prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Rahasia sesi (JWT). Isi string acak panjang, mis. hasil: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# RPC Sepolia untuk server (relayer + baca kontrak)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Wallet relayer: membayar gas untuk semua pengguna. Butuh Sepolia ETH.
# Untuk faucet IDRX dan freeze otomatis, wallet ini harus owner MockIDRX dan punya ADMIN/FREEZER_ROLE
# (deployer di piutangchain-contracts/.env memenuhi keduanya).
RELAYER_PRIVATE_KEY=

# Folder upload dokumen & bukti transfer (relatif ke apps/web)
UPLOAD_DIR=uploads
